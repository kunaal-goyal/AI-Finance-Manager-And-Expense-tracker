# ==============================================================================
# SPENDWISE AI - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. Supabase PostgreSQL & Auth Credentials
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. Google Gemini API Key
# Obtain from https://aistudio.google.com/app/apikey
# NEVER expose this key in frontend code; it is strictly used in server-side API routes (/api/ai/chat)
GEMINI_API_KEY=your-google-gemini-api-key-here

# 3. Application URL (Optional, defaults to localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
